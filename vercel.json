{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/download", "destination": "/#download", "permanent": false },
    { "source": "/downloads", "destination": "/#download", "permanent": false },
    { "source": "/apk", "destination": "/#download", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/config.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/version.json", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "Access-Control-Allow-Origin", "value": "*" } ] },
    { "source": "/m/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
